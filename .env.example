LLM_MODEL=gpt-4o-mini  # gemma2:9b , gpt-4o-mini , qwen2.5-coder:7b-instruct 


DOCUMENT_DIR = documents
CHROMA_DIR = chroma_db
COLLECTION_NAME = ai_knowledge
EMBEDDING_MODEL = nomic-embed-text   # embeddinggemma-2, nomic-embed-text, bge-m3


CHUNK_SIZE = 2400
CHUNK_OVERLAP = 250

# Toggle terminal console logs (true/false)
ENABLE_CONSOLE_LOGGING=false

# Toggle rotating file logs (true/false)
ENABLE_FILE_LOGGING=true


EMBEDDING_BATCH_SIZE = 16  # Increase to 32 0r 64 after stable indexing

OLLAMA_BASE_URL = "http://127.0.0.1:11434"